{
  "name": "dsh-global-persona",
  "version": "1.0.0",
  "private": true,
  "description": "Global persona for DeepSeek Harness: a Settings section that shows and edits the user-global AGENTS.md.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "license": "MIT",
  "author": "hunbujiu (https://github.com/hunbujiu)",
  "homepage": "https://github.com/hunbujiu/dsh-global-persona#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hunbujiu/dsh-global-persona.git"
  },
  "bugs": {
    "url": "https://github.com/hunbujiu/dsh-global-persona/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "agents-md",
    "persona"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  }
}
